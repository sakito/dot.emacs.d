root = true

[*]
charset = utf-8
end_of_line = lf

trim_trailing_whitespace = false
insert_final_newline = true
max_line_length = 88
indent_style = space

[*.py]
quote_type = single
indent_size = 4

[*.{rst,md,org}]
indent_size = 2

[Makefile]
indent_style = tab
tab_width = 4

[.gitmodules]
indent_style = tab
tab_width = 4
